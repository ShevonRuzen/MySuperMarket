datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  STOCK
}

enum ProductUnit {
  EACH
  KG
  G
  L
}

enum StockMovementType {
  PURCHASE
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  DAMAGE
  RETURN
  COUNT
}

enum PurchaseStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  PAID
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  SPLIT_CASH
  SPLIT_CARD
}

enum TransferStatus {
  REQUESTED
  APPROVED
  IN_TRANSIT
  RECEIVED
  REJECTED
}

enum ApprovalType {
  REFUND
  PRICE_CHANGE
  TRANSFER
  OVERTIME
  HIRE
  ADVANCE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------
// Organization
// ----------------------------------------------------
model Branch {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  address     String
  city        String
  phone       String
  openingTime String?
  closingTime String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users             User[]
  terminals         Terminal[]
  branchProducts    BranchProduct[]
  stocks            Stock[]
  stockMovements    StockMovement[]
  purchases         Purchase[]
  shifts            Shift[]
  sales             Sale[]
  heldSales         HeldSale[]
  outgoingTransfers StockTransfer[] @relation("FromBranch")
  incomingTransfers StockTransfer[] @relation("ToBranch")
  auditLogs         AuditLog[]
  approvalRequests  ApprovalRequest[]
  settings          Setting[]
}

model User {
  id           String   @id @default(uuid())
  branchId     String?
  role         Role
  name         String
  email        String   @unique
  passwordHash String
  pinHash      String?  // 4-6 digit keypad PIN for cashiers
  salary       Decimal? @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  shifts           Shift[]
  sales            Sale[]
  heldSales        HeldSale[]
  stockMovements   StockMovement[]
  attendances      Attendance[]
  salaries         Salary[]
  salaryAdvances   SalaryAdvance[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  approvalRequests ApprovalRequest[] @relation("RequestedBy")
  approvedRequests ApprovalRequest[] @relation("ApprovedBy")
}

model Terminal {
  id            String    @id @default(uuid())
  branchId      String
  name          String
  lastSeenAt    DateTime?
  bridgeVersion String?
  createdAt     DateTime  @default(now())

  branch        Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shifts        Shift[]
  heldSales     HeldSale[]
}

// ----------------------------------------------------
// Products & Catalog
// ----------------------------------------------------
model Category {
  id        String     @id @default(uuid())
  parentId  String?
  name      String
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("SubCategories")
  products  Product[]
}

model Supplier {
  id          String     @id @default(uuid())
  name        String
  contactName String?
  phone       String
  email       String?
  creditDays  Int        @default(30)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  purchases   Purchase[]
}

model Product {
  id          String      @id @default(uuid())
  categoryId  String?
  name        String
  costPrice   Decimal     @db.Decimal(10, 2)
  isWeighed   Boolean     @default(false)
  unit        ProductUnit @default(EACH)
  imageUrl    String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category       Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  barcodes       ProductBarcode[]
  branchProducts BranchProduct[]
  stocks         Stock[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  saleItems      SaleItem[]
  transferItems  StockTransferItem[]
}

model ProductBarcode {
  id        String   @id @default(uuid())
  productId String
  barcode   String   @unique
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([barcode])
}

model BranchProduct {
  id            String   @id @default(uuid())
  branchId      String
  productId     String
  sellingPrice  Decimal  @db.Decimal(10, 2)
  reorderLevel  Int      @default(10)
  shelfLocation String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceChangeLogs PriceChangeLog[]

  @@unique([branchId, productId])
}

model PriceChangeLog {
  id              String        @id @default(uuid())
  branchProductId String
  oldPrice        Decimal       @db.Decimal(10, 2)
  newPrice        Decimal       @db.Decimal(10, 2)
  changedBy       String
  reason          String?
  createdAt       DateTime      @default(now())

  branchProduct   BranchProduct @relation(fields: [branchProductId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// Inventory & Stock
// ----------------------------------------------------
model Stock {
  id        String   @id @default(uuid())
  branchId  String
  productId String
  quantity  Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model StockMovement {
  id         String            @id @default(uuid())
  branchId   String
  productId  String
  userId     String?
  type       StockMovementType
  qtyChange  Decimal           @db.Decimal(12, 3)
  qtyBefore  Decimal           @db.Decimal(12, 3)
  qtyAfter   Decimal           @db.Decimal(12, 3)
  reference  String?
  createdAt  DateTime          @default(now())

  branch     Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([branchId, productId])
  @@index([createdAt])
}

// ----------------------------------------------------
// Purchasing (PO & GRN)
// ----------------------------------------------------
model Purchase {
  id           String         @id @default(uuid())
  branchId     String
  supplierId   String
  status       PurchaseStatus @default(DRAFT)
  expectedDate DateTime?
  receivedDate DateTime?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier     Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items        PurchaseItem[]
}

model PurchaseItem {
  id          String   @id @default(uuid())
  purchaseId  String
  productId   String
  orderedQty  Decimal  @db.Decimal(12, 3)
  receivedQty Decimal  @default(0) @db.Decimal(12, 3)
  costPrice   Decimal  @db.Decimal(10, 2)
  shortQty    Decimal  @default(0) @db.Decimal(12, 3)

  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// Sales, Shifts & Payments
// ----------------------------------------------------
model Shift {
  id              String      @id @default(uuid())
  branchId        String
  terminalId      String
  cashierId       String
  openingFloat    Decimal     @db.Decimal(10, 2)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  expectedCash    Decimal?    @db.Decimal(10, 2)
  countedCash     Decimal?    @db.Decimal(10, 2)
  difference      Decimal?    @db.Decimal(10, 2)
  zReportPrinted  Boolean     @default(false)
  status          ShiftStatus @default(OPEN)

  branch          Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terminal        Terminal    @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  cashier         User        @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  sales           Sale[]
}

model Sale {
  id         String     @id @default(uuid())
  offlineId  String?    @unique // Dedup identifier from offline client
  branchId   String
  shiftId    String
  cashierId  String
  invoiceNo  String     @unique
  subtotal   Decimal    @db.Decimal(10, 2)
  discount   Decimal    @default(0) @db.Decimal(10, 2)
  total      Decimal    @db.Decimal(10, 2)
  status     SaleStatus @default(PAID)
  createdAt  DateTime   @default(now())
  syncedAt   DateTime   @default(now())

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift      Shift      @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashier    User       @relation(fields: [cashierId], references: [id], onDelete: Cascade)
  items      SaleItem[]
  payments   Payment[]
  refunds    Refund[]

  @@index([branchId, createdAt])
  @@index([invoiceNo])
}

model SaleItem {
  id             String   @id @default(uuid())
  saleId         String
  productId      String
  qty            Decimal  @db.Decimal(12, 3)
  unitPrice      Decimal  @db.Decimal(10, 2)
  discountAmount Decimal  @default(0) @db.Decimal(10, 2)
  weightKg       Decimal? @db.Decimal(10, 3)
  lineTotal      Decimal  @db.Decimal(10, 2)

  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  cashTendered  Decimal?      @db.Decimal(10, 2)
  changeGiven   Decimal?      @db.Decimal(10, 2)
  payhereRef    String?
  createdAt     DateTime      @default(now())

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model HeldSale {
  id         String   @id @default(uuid())
  branchId   String
  terminalId String
  cashierId  String
  holdRef    String
  cartJson   Json
  heldAt     DateTime @default(now())

  branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  terminal   Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)
  cashier    User     @relation(fields: [cashierId], references: [id], onDelete: Cascade)
}

model Refund {
  id         String         @id @default(uuid())
  saleId     String
  cashierId  String
  approvedBy String?
  total      Decimal        @db.Decimal(10, 2)
  reason     String
  status     ApprovalStatus @default(PENDING)
  createdAt  DateTime       @default(now())

  sale       Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// Stock Transfers
// ----------------------------------------------------
model StockTransfer {
  id           String         @id @default(uuid())
  fromBranchId String
  toBranchId   String
  requestedBy  String
  approvedBy   String?
  status       TransferStatus @default(REQUESTED)
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  fromBranch   Branch              @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: Cascade)
  toBranch     Branch              @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: Cascade)
  items        StockTransferItem[]
}

model StockTransferItem {
  id           String        @id @default(uuid())
  transferId   String
  productId    String
  requestedQty Decimal       @db.Decimal(12, 3)
  confirmedQty Decimal?      @db.Decimal(12, 3)

  transfer     StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// Staff & HR
// ----------------------------------------------------
model Attendance {
  id             String    @id @default(uuid())
  userId         String
  date           DateTime  @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  overrideBy     String?
  overrideReason String?

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Salary {
  id               String    @id @default(uuid())
  userId           String
  month            DateTime  @db.Date
  baseSalary       Decimal   @db.Decimal(10, 2)
  overtimePay      Decimal   @default(0) @db.Decimal(10, 2)
  advanceDeduction Decimal   @default(0) @db.Decimal(10, 2)
  netSalary        Decimal   @db.Decimal(10, 2)
  paidAt           DateTime?
  paidBy           String?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model SalaryAdvance {
  id         String         @id @default(uuid())
  userId     String
  amount     Decimal        @db.Decimal(10, 2)
  reason     String
  status     ApprovalStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime       @default(now())

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// System, Audit & Approvals
// ----------------------------------------------------
model ApprovalRequest {
  id          String         @id @default(uuid())
  type        ApprovalType
  branchId    String
  requestedBy String
  approvedBy  String?
  status      ApprovalStatus @default(PENDING)
  payload     Json
  createdAt   DateTime       @default(now())
  resolvedAt  DateTime?

  branch      Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  requester   User           @relation("RequestedBy", fields: [requestedBy], references: [id], onDelete: Cascade)
  approver    User?          @relation("ApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
}

model AuditLog {
  id        String   @id @default(uuid())
  branchId  String?
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  ip        String?
  createdAt DateTime @default(now())

  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Setting {
  id        String   @id @default(uuid())
  key       String
  value     String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([key, branchId])
}
