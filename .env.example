# ===============================================
# MySuperMarket Environment Configuration Template
# ===============================================

# Database (PostgreSQL 15)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/mysupermarket?schema=public"

# Redis Cache & Queues (Redis 7)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="supermarket_jwt_secret_key_change_in_production_32chars"
JWT_REFRESH_SECRET="supermarket_jwt_refresh_secret_key_change_in_production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PayHere Sandbox Credentials
PAYHERE_MERCHANT_ID="1211149"
PAYHERE_MERCHANT_SECRET="sandbox_secret_key"
PAYHERE_SANDBOX="true"
PAYHERE_CURRENCY="LKR"

# Application Ports & URLs
PORT=3000
API_URL="http://localhost:3000"
ADMIN_URL="http://localhost:5173"
POS_URL="http://localhost:5174"
BRIDGE_WS_URL="ws://localhost:17777"
SCANNER_URL="http://localhost:5555"

# Environment Mode
NODE_ENV="development"
